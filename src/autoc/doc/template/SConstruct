import os
import sys
import subprocess

env = Environment(tools=["default"])

# Load site-local configuration if present
_site = ".autoc/scons.site"
if os.path.exists(_site):
  _site_vars = {}
  with open(_site, "r") as _f:
    exec(_f.read(), _site_vars)
  for _k, _v in _site_vars.items():
    if _k == "PYTHON":
      env["PYTHON"] = _v
    elif _k == "AUTOC_PYTHONPATH":
      env["AUTOC_PYTHONPATH"] = _v

project = "@project@"
module = "@module@"

py_exec = env.get("PYTHON", sys.executable)
py_env = os.environ.copy()
if env.get("AUTOC_PYTHONPATH"):
  py_env["PYTHONPATH"] = (
    f"{env['AUTOC_PYTHONPATH']}{os.pathsep}{py_env['PYTHONPATH']}"
    if "PYTHONPATH" in py_env
    else env["AUTOC_PYTHONPATH"]
  )

def run_generator(target, source, env):
  res = subprocess.run([py_exec, os.path.abspath(str(source[0])), module], env=py_env)
  return res.returncode

gen = env.Command(f"{module}_auto.h", f"{module}.py", Action(run_generator, f"-- Generating AutoC module {module}"))

def run_doxygen(target, source, env):
  res = subprocess.run(["doxygen", "Doxyfile"])
  return res.returncode

doc = env.Command("reference", [gen, "Doxyfile"], Action(run_doxygen, "-- Generating documentation with Doxygen"))
Default(doc)
